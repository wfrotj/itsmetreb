  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "vercel dev",
    "build": "vite build",
    "start": "node server/index.js",
    "start:web": "vite preview --host 0.0.0.0 --port $PORT",
