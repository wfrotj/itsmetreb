# =============================================================================
# Frontend (Vercel) — public / build-time vars
# =============================================================================

# Cloudflare Turnstile site key (public): https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=

# Backend API URL (Render). Example:
# VITE_API_URL=https://itsmetreb.onrender.com/api/contact
VITE_API_URL=

# =============================================================================
# Backend (Render) — server secrets (also add in Render → Environment)
# =============================================================================

# Resend: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=Wilbert Rodrigo <noreply@staging.mast-ready.com>
CONTACT_EMAIL=wilbert.rodrigo.dev@gmail.com

# Cloudflare Turnstile secret (server only)
TURNSTILE_SECRET_KEY=

# Upstash Redis for rate limiting: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Allowed frontend origins for CORS (comma-separated)
# Example: https://your-site.vercel.app,https://yourdomain.com
FRONTEND_URL=

# Local backend dev: run `npm start` then set:
# VITE_API_URL=http://localhost:3000/api/contact
