# Resend API key: https://resend.com/api-keys
# Add these same variables in Vercel → Project → Settings → Environment Variables
RESEND_API_KEY=

# Verified sender (sandbox: onboarding@resend.dev; production: use your verified domain)
RESEND_FROM_EMAIL=Wilbert Rodrigo <onboarding@resend.dev>

# Where incoming messages are delivered
CONTACT_EMAIL=wilbert.rodrigo.dev@gmail.com

# Cloudflare Turnstile: https://dash.cloudflare.com/?to=/:account/turnstile
# Test keys (always pass): site=1x00000000000000000000AA secret=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis for rate limiting (production): https://console.upstash.com/
# Free tier works. Without these, local dev uses in-memory limits only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: override API path for local testing
# VITE_API_URL=/api/contact
