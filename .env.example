# =============================================================================
# Frontend (Render web service OR Vercel)
# Set before `npm run build` so the site knows where the API lives.
# =============================================================================

VITE_TURNSTILE_SITE_KEY=
# Example: https://itsmetreb-api.onrender.com/api/contact
VITE_API_URL=

# =============================================================================
# Backend (Render API service — npm run start)
# Add these in Render → itsmetreb-api → Environment
# =============================================================================

RESEND_API_KEY=
RESEND_FROM_EMAIL=Wilbert Rodrigo <noreply@staging.mast-ready.com>
CONTACT_EMAIL=wilbert.rodrigo.dev@gmail.com
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated frontend URLs allowed to call the API
# Example: https://itsmetreb-web.onrender.com,https://your-site.vercel.app
FRONTEND_URL=

# =============================================================================
# Render frontend service uses: Build = npm run build, Start = npm run dev
# Render backend service uses:  Build = npm install --omit=dev, Start = npm run start
# =============================================================================
