# =============================================================================
# Render (one service): Build = npm run build | Start = npm start
# Add ALL of these in Render → Environment, then redeploy.
# =============================================================================

# Public (baked into frontend at build time)
VITE_TURNSTILE_SITE_KEY=
# Leave empty on Render so the form posts to same origin: /api/contact
# VITE_API_URL=

# Server secrets
RESEND_API_KEY=
RESEND_FROM_EMAIL=Wilbert Rodrigo <noreply@staging.mast-ready.com>
CONTACT_EMAIL=wilbert.rodrigo.dev@gmail.com
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional CORS allowlist (usually not needed when frontend is on same Render URL)
# FRONTEND_URL=https://your-app.onrender.com

# =============================================================================
# Local:
#   npm run start                 → API on :3000 (after npm run build for site)
#   npm run dev:api               → Vite + local /api/contact on :5173
#   OR npm run start + npm run dev with VITE_API_URL=http://localhost:3000/api/contact
# =============================================================================
